# Directory for the SQLite database and (optionally) encrypted images. Default: ./data
PSL_ARENA_DATA_DIR=./data
# 32-byte hex key for AES-256-GCM encryption of stored images. If unset, a key is generated
# on first run and stored at $PSL_ARENA_DATA_DIR/image.key (mode 0600).
# PSL_ARENA_IMAGE_KEY=
# Product branding (also configurable in src/config/brand.ts)
NEXT_PUBLIC_APP_NAME=PSL ARENA
# Allow new accounts after the first one was created (default true). Set to false to lock sign-up.
PSL_ARENA_ALLOW_SIGNUP=true
